generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./hyktec.db"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("client") // super_admin, admin, manager, developer, marketing, support, client
  company      String?
  phone        String?
  status       String   @default("active") // active, disabled
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clients        Client[]
  assignedTasks  Task[]          @relation("TaskAssignee")
  ticketMessages TicketMessage[]
  activityLogs   ActivityLog[]
}

model Lead {
  id               String   @id @default(uuid())
  name             String
  company          String?
  email            String
  phone            String?
  country          String?
  service          String
  budget           String?
  projectType      String?
  expectedTimeline String?
  description      String
  websiteUrl       String?
  preferredContact String?  @default("email")
  status           String   @default("new") // new, contacted, qualified, proposal_sent, negotiation, won, lost
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Client {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  industry    String?
  country     String?
  website     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects  Project[]
  tickets   Ticket[]
  invoices  Invoice[]
  documents Document[]
}

model Project {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  serviceType String
  status      String   @default("planning") // planning, design, development, testing, review, live, maintenance, completed
  progress    Int      @default(0) // 0 - 100
  budget      Float?
  startDate   String?
  endDate     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestones Milestone[]
  tasks      Task[]
  invoices   Invoice[]
  documents  Document[]
}

model Milestone {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("pending") // pending, in_progress, completed
  dueDate     String?
  createdAt   DateTime @default(now())
}

model Task {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("todo") // todo, in_progress, review, done
  priority    String   @default("medium") // low, medium, high, urgent
  dueDate     String?
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ticket {
  id        String   @id @default(uuid())
  ticketNum String   @unique
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subject   String
  category  String   @default("general") // general, bug, maintenance, billing, feature
  priority  String   @default("medium") // low, medium, high, urgent
  status    String   @default("open") // open, in_progress, waiting_client, resolved, closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User     @relation(fields: [senderId], references: [id])
  senderType String   @default("client") // client, admin, support
  message    String
  fileUrl    String?
  createdAt  DateTime @default(now())
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id])
  amount        Float
  tax           Float    @default(0.0)
  discount      Float    @default(0.0)
  status        String   @default("pending") // pending, paid, overdue, cancelled
  dueDate       String
  paidAt        String?
  notes         String?
  createdAt     DateTime @default(now())

  items InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  amount      Float
}

model Document {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  title     String
  category  String   @default("contract") // contract, proposal, report, deliverable, invoice
  fileUrl   String
  fileSize  String?
  createdAt DateTime @default(now())
}

model BlogPost {
  id             String    @id @default(uuid())
  title          String
  slug           String    @unique
  content        String
  excerpt        String
  category       String
  author         String    @default("Hyktec Team")
  status         String    @default("published") // draft, published, archived
  featuredImage  String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime? @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Service {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  summary      String
  iconName     String
  category     String
  featuresJson String   @default("[]")
  isPopular    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model PricingPlan {
  id           String   @id @default(uuid())
  category     String   // Website, Digital Marketing, App Development, AI Solutions
  name         String   // Starter, Business, Professional, Enterprise
  price        String   // e.g. "$1,499" or "Custom"
  period       String   @default("one-time") // one-time, /month, /project
  featuresJson String   @default("[]")
  isPopular    Boolean  @default(false)
  ctaText      String   @default("Choose Plan")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model PortfolioProject {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  category         String   // Websites, Mobile Apps, Web Applications, AI, Digital Marketing, E-commerce
  clientName       String
  industry         String
  challenge        String
  solution         String
  result           String
  technologiesJson String   @default("[]")
  liveUrl          String?
  featuredImage    String?
  createdAt        DateTime @default(now())
}

model WebsiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("general") // general, branding, seo, email, security
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}
